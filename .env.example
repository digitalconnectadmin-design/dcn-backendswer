#############################################
# dcn-backend — API service (Render + Neon)
#############################################

# ---------- Required to run at all ----------

# Neon connection string. Use the POOLED host (it has `-pooler` in the
# hostname) from the Neon dashboard → Connection Details.
#
# The driver here is @neondatabase/serverless over HTTP, which opens no
# long-lived socket, so the pooled endpoint is the right choice and Render's
# instance count doesn't affect your Postgres connection budget.
#
# Note: this driver does not support interactive transactions. The app uses
# none (checked — zero `db.transaction` calls across the whole codebase), so
# that costs nothing today. If a future feature needs one, switch that file to
# `drizzle-orm/node-postgres` with a `pg` Pool; Render's persistent instances
# can hold a real pool, unlike the serverless host this was originally on.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# 32+ random bytes. Generate: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=""

# This service's own public URL — no trailing slash.
#   local:  http://localhost:4000
#   Render: https://dcn-backend.onrender.com
# better-auth builds absolute URLs from this (OAuth redirects especially), so
# a wrong value here produces OAuth callbacks that 404 on a host that isn't us.
BETTER_AUTH_URL="http://localhost:4000"

# Origins allowed to call this API, comma-separated, no trailing slashes.
# This is the single most common thing to get wrong in a split deployment: a
# missing entry shows up as a request that plainly succeeded in the Render logs
# and a frontend reporting a network error.
#
# In development, localhost:3000/3001 and 127.0.0.1:3000 are allowed
# automatically — list only the deployed frontend origins here.
CORS_ORIGINS="http://localhost:3000"


# ---------- Scheduled publishing ----------

# Shared secret for GET /api/v1/cron/publish-scheduled.
# Render Cron Jobs send it as: Authorization: Bearer $CRON_SECRET
# If unset the endpoint is unauthenticated — fine locally, not in production.
CRON_SECRET=""


# ---------- Media uploads (UploadThing) ----------

# From the UploadThing dashboard. The browser uploads straight to UploadThing;
# this service only authorises the request and records the resulting asset.
UPLOADTHING_TOKEN=""


# ---------- Social publishing (all optional) ----------
# Each connect button shows "not configured yet" until its pair is set.
# Nothing else breaks when these are absent.

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Instagram publishing goes through the Facebook app above (Graph API).

X_CLIENT_ID=""
X_CLIENT_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# YouTube uses the Google OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""


# ---------- AI news feed (optional) ----------

# Anthropic key for the RSS ingest's summarise/categorise step
# (/admin/ai-feed). The feed still ingests without it; only the AI pass is off.
ANTHROPIC_API_KEY=""


# ---------- Live broadcast (optional) ----------

# The relay service in the original repo's relay/ directory. It runs ffmpeg and
# holds sockets open for the length of a broadcast, so it cannot live in this
# service — see the deployment note in README.md.
LIVE_RELAY_URL=""
LIVE_RELAY_SECRET=""

# TURN server for the Web Studio's WebRTC. Optional, but without it some
# guests on restrictive mobile networks will not connect at all.
STUDIO_TURN_URL=""
STUDIO_TURN_USERNAME=""
STUDIO_TURN_PASSWORD=""

# How often the live console polls each platform for viewers/chat, in ms.
# Default 10000. Raising it stretches YouTube's daily API quota further.
LIVE_PLATFORM_POLL_MS=""
